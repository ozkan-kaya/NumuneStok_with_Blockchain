@model NumuneStok.Models.Category

<h3>İlgili kategoriyi silmek istediğinizden emin misiniz?</h3>
<div>
    <h4>Kategori Adı: @Model.CategoryName</h4>
    <h4>Kategori Açıklaması: @Model.Description</h4>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sil</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>