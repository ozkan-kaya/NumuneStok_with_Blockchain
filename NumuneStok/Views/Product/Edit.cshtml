@model NumuneStok.Models.Product

<h2>Ürün Düzenle</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        Ürün Adı
        <input asp-for="ProductName" class="form-control" />
        <span asp-validation-for="ProductName" class="text-danger"></span>
    </div>

    <div class="form-group">
        Referans Numarası
        <input asp-for="ReferenceNumber" class="form-control" />
        <span asp-validation-for="ReferenceNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        Barkod
        <input asp-for="Barcode" class="form-control" />
        <span asp-validation-for="Barcode" class="text-danger"></span>
    </div>

    <div class="form-group">
        Konum
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>

    <div class="form-group">
        Aylık Sipariş Adeti
        <input asp-for="Order" class="form-control" />
        <span asp-validation-for="Order" class="text-danger"></span>
    </div>

    <div class="form-group">
        Kritik Eşik
        <input asp-for="Critical" class="form-control" />
        <span asp-validation-for="Critical" class="text-danger"></span>
    </div>

    <div class="form-group">
        Test Değeri
        <input asp-for="MultiplicationValue" class="form-control" />
        <span asp-validation-for="MultiplicationValue" class="text-danger"></span>
    </div>

    <div class="form-group">
        Adet
        <input asp-for="Quantity" class="form-control" readonly />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="form-group">
        Kategori
        <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories"></select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Kaydet" class="btn btn-primary" />
    </div>
</form>
