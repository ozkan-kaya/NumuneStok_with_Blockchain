@model List<NumuneStok.Services.BlockchainRecord>

@{
    ViewData["Title"] = "Blockchain Doğrulama Geçmişi (Tüm Ürün)";
    var productName = ViewBag.ProductName as string;
}

<style>
    /* ─── Blockchain Timeline Stilleri ─── */
    .bc-header {
        background: #ffffff;
        border-radius: 10px;
        padding: 20px 24px;
        margin-bottom: 28px;
        color: #333;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }

    .bc-header h2 {
        margin: 0 0 6px 0;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .bc-header .lot-badge {
        display: inline-block;
        background: #f8f9fa;
        border: 1px solid #ccc;
        border-radius: 6px;
        padding: 4px 14px;
        font-family: 'Courier New', monospace;
        font-size: 1rem;
        font-weight: 600;
        color: #e94560;
        letter-spacing: 1px;
    }

    .bc-header .subtitle {
        font-size: 0.85rem;
        color: #666;
        margin-top: 4px;
    }

    /* Timeline Container */
    .bc-timeline {
        position: relative;
        padding-left: 40px;
        margin: 0 0 40px 20px;
    }

    .bc-timeline::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: linear-gradient(to bottom, #e94560, #0f3460);
        border-radius: 3px;
    }

    /* Timeline Item */
    .bc-timeline-item {
        position: relative;
        margin-bottom: 24px;
        padding-left: 24px;
    }

    .bc-timeline-item::before {
        content: '';
        position: absolute;
        left: -46px;
        top: 16px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 3px solid #fff;
        box-shadow: 0 0 0 3px #e94560, 0 0 12px rgba(233, 69, 96, 0.4);
        z-index: 1;
    }

    .bc-timeline-item.action-added::before { background: #27ae60; box-shadow: 0 0 0 3px #27ae60, 0 0 12px rgba(39, 174, 96, 0.4); }
    .bc-timeline-item.action-deducted::before { background: #e94560; box-shadow: 0 0 0 3px #e94560, 0 0 12px rgba(233, 69, 96, 0.4); }
    .bc-timeline-item.action-produced::before { background: #8b5cf6; box-shadow: 0 0 0 3px #8b5cf6, 0 0 12px rgba(139, 92, 246, 0.4); }
    .bc-timeline-item.action-shipped::before { background: #f97316; box-shadow: 0 0 0 3px #f97316, 0 0 12px rgba(249, 115, 22, 0.4); }
    .bc-timeline-item.action-received::before { background: #3b82f6; box-shadow: 0 0 0 3px #3b82f6, 0 0 12px rgba(59, 130, 246, 0.4); }
    .bc-timeline-item.action-transferred::before { background: #eab308; box-shadow: 0 0 0 3px #eab308, 0 0 12px rgba(234, 179, 8, 0.4); }
    .bc-timeline-item.action-consumed::before { background: #ef4444; box-shadow: 0 0 0 3px #ef4444, 0 0 12px rgba(239, 68, 68, 0.4); }
    .bc-timeline-item.action-genesis::before { background: #d97706; box-shadow: 0 0 0 3px #d97706, 0 0 12px rgba(217, 119, 6, 0.4); }

    .bc-card {
        background: #fff;
        border-radius: 10px;
        padding: 18px 22px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        border-left: 4px solid #ddd;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .bc-card:hover {
        transform: translateX(4px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    }

    .bc-card.card-added { border-left-color: #27ae60; }
    .bc-card.card-deducted { border-left-color: #e94560; }
    .bc-card.card-produced { border-left-color: #8b5cf6; }
    .bc-card.card-shipped { border-left-color: #f97316; }
    .bc-card.card-received { border-left-color: #3b82f6; }
    .bc-card.card-transferred { border-left-color: #eab308; }
    .bc-card.card-consumed { border-left-color: #ef4444; }
    .bc-card.card-genesis { border-left-color: #d97706; }

    .bc-card .action-badge {
        display: inline-block;
        padding: 3px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .bc-card .action-badge.badge-added { background: #d4edda; color: #155724; }
    .bc-card .action-badge.badge-deducted { background: #f8d7da; color: #721c24; }
    .bc-card .action-badge.badge-produced { background: #ede9fe; color: #5b21b6; }
    .bc-card .action-badge.badge-shipped { background: #ffedd5; color: #9a3412; }
    .bc-card .action-badge.badge-received { background: #dbeafe; color: #1e40af; }
    .bc-card .action-badge.badge-transferred { background: #fef9c3; color: #854d0e; }
    .bc-card .action-badge.badge-consumed { background: #fee2e2; color: #991b1b; }
    .bc-card .action-badge.badge-genesis { background: #fef3c7; color: #92400e; }

    .bc-card .card-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 10px;
        flex-wrap: wrap;
        gap: 8px;
    }

    .bc-card .card-row .label {
        font-size: 0.75rem;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .bc-card .card-row .value {
        font-size: 0.85rem;
        color: #333;
        font-weight: 500;
    }

    .bc-card .wallet-address {
        font-family: 'Courier New', monospace;
        font-size: 0.78rem;
        color: #0f3460;
        word-break: break-all;
    }

    .bc-card .timestamp {
        font-size: 0.85rem;
        color: #555;
        font-weight: 500;
    }

    /* Empty State */
    .bc-empty {
        text-align: center;
        padding: 60px 20px;
        background: #f8f9fa;
        border-radius: 12px;
        border: 2px dashed #dee2e6;
    }

    .bc-empty .icon {
        font-size: 3rem;
        margin-bottom: 12px;
    }

    .bc-empty h4 {
        color: #495057;
        margin-bottom: 8px;
    }

    .bc-empty p {
        color: #868e96;
        font-size: 0.9rem;
    }

    /* Record Count Badge */
    .bc-count {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(233, 69, 96, 0.1);
        color: #e94560;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .bc-status-panel {
        background: #fff;
        border-radius: 10px;
        padding: 18px 22px;
        margin-bottom: 24px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }

    .bc-status-panel h3 {
        margin: 0 0 12px 0;
        font-size: 1.1rem;
        font-weight: 700;
        color: #333;
    }

    .bc-status-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }

    .bc-status-table th,
    .bc-status-table td {
        padding: 10px 12px;
        border-bottom: 1px solid #eef2f7;
        text-align: left;
    }

    .bc-status-table th {
        color: #64748b;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .bc-status-pill {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 16px;
        background: #eef2ff;
        color: #3730a3;
        font-weight: 700;
        font-size: 0.78rem;
    }
</style>

@{
    var isBcUp = ViewBag.BlockchainAvailable != null && (bool)ViewBag.BlockchainAvailable;
}

@if (!isBcUp)
{
    <div class="alert alert-danger">
        <strong>Sistem Uyarısı:</strong> Blockchain ağına erişilemiyor. Lütfen daha sonra tekrar deneyin veya sistem yöneticisiyle iletişime geçin.
    </div>
}
else
{
    <!-- ─── Header ─── -->
    <div class="bc-header">
        <h2>Blockchain Doğrulama Geçmişi</h2>
        <div style="margin-top: 8px;">
            <span class="subtitle">Ürün Adı:</span>
            <span class="lot-badge">@productName</span>
        </div>
        <div class="subtitle" style="margin-top: 10px;">
            <span class="bc-count">
                📋 @Model.Count kayıt bulundu
            </span>
            &nbsp;|&nbsp; Tüm veriler değiştirilemez blokzincirinden alınmıştır.
        </div>
    </div>

    var dbStock = ViewBag.DatabaseTotalStock != null ? (int)ViewBag.DatabaseTotalStock : 0;
    var comparableDbStock = ViewBag.BlockchainComparableDatabaseStock != null ? (int)ViewBag.BlockchainComparableDatabaseStock : dbStock;
    var uninitializedLotStock = ViewBag.UninitializedLotStock != null ? (int)ViewBag.UninitializedLotStock : 0;
    var uninitializedLotCount = ViewBag.UninitializedLotCount != null ? (int)ViewBag.UninitializedLotCount : 0;
    var uninitializedLotNumbers = ViewBag.UninitializedLotNumbers as List<string> ?? new List<string>();
    var blockchainLotStatuses = ViewBag.BlockchainLotStatuses as List<NumuneStok.Services.BlockchainLotStatus> ?? new List<NumuneStok.Services.BlockchainLotStatus>();
    var blockchainCoverageError = ViewBag.BlockchainCoverageError as string;
    var bcStock = 0;

    foreach(var r in Model)
    {
        if (r.Action == "Added" || r.Action == "Received" || r.Action == "Genesis") 
        {
            bcStock += r.Quantity;
        }
        else if (r.Action == "Deducted" || (r.Action == "Consumed" && r.ToLocation == "Tüketildi")) 
        {
            bcStock -= r.Quantity;
        }
    }

    if (!string.IsNullOrEmpty(blockchainCoverageError))
    {
        <div style="background-color: #f8d7da; color: #721c24; padding: 15px 20px; border-left: 6px solid #f5c6cb; border-radius: 8px; margin-bottom: 30px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
            <h3 style="margin-top: 0; display: flex; align-items: center; gap: 10px; font-size: 1.3rem;">
                <strong>Blockchain Kapsamı Tamamlanamadı</strong>
                <span style="font-size: 1.5rem;">⚠️</span>
            </h3>
            <p style="font-size: 1.05rem; margin-bottom: 0;">
                Blockchain geçmişi okunurken hata oluştu:
                <strong>@blockchainCoverageError</strong>
            </p>
        </div>
    }
    else if (dbStock > 0 && Model.Count == 0)
    {
        <div style="background-color: #f8d7da; color: #721c24; padding: 15px 20px; border-left: 6px solid #f5c6cb; border-radius: 8px; margin-bottom: 30px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
            <h3 style="margin-top: 0; display: flex; align-items: center; gap: 10px; font-size: 1.3rem;">
                <strong>Blockchain Başlangıç Kaydı Oluşturulamadı</strong>
                <span style="font-size: 1.5rem;">⚠️</span>
            </h3>
            <p style="font-size: 1.05rem; margin-bottom: 12px;">
                Bu ürün için veritabanında <strong>@dbStock Adet</strong> stok var; ancak blockchain üzerinde henüz kayıt bulunamadı.
                Mevcut stoklar yalnızca <strong>Blockchain/scripts/start_and_sync.sh</strong> ilk kurulum script'i çalıştırıldığında blockchain'e alınır. Kayıt hâlâ yoksa blockchain node, contract address veya deploy edilmiş sözleşme sürümü kontrol edilmelidir.
            </p>
        </div>
    }
    else if (bcStock < comparableDbStock || uninitializedLotStock > 0)
    {
        var missingComparableStock = Math.Max(0, comparableDbStock - bcStock);
        var totalPendingBlockchainStock = missingComparableStock + uninitializedLotStock;

        <div style="background-color: #f8d7da; color: #721c24; padding: 15px 20px; border-left: 6px solid #f5c6cb; border-radius: 8px; margin-bottom: 30px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
            <h3 style="margin-top: 0; display: flex; align-items: center; gap: 10px; font-size: 1.3rem;">
                <strong>Blockchain Başlangıç Envanteri Eksik</strong>
                <span style="font-size: 1.5rem;">⚠️</span>
            </h3>
            <p style="font-size: 1.05rem; margin-bottom: 8px;">
                Ürünün toplam veritabanı stoğu <strong>@dbStock Adet</strong>, blockchain toplamı şu an <strong>@bcStock Adet</strong>.
                Aradaki <strong>@totalPendingBlockchainStock Adet</strong> fark, ilk kurulum script'iyle blockchain'e alınması gereken mevcut stok kayıtlarının eksik kaldığını gösterir.
            </p>
            @if (missingComparableStock > 0)
            {
                <p style="font-size: 0.92rem; margin-bottom: 6px;">
                    Blockchain hareketi görmüş lotlarda eksik başlangıç envanteri miktarı: <strong>@missingComparableStock Adet</strong>.
                    Bu fark normal kabul edilmez; blockchain sözleşmesinin deploy edildiğinden emin olup uygulamayı yeniden başlatmak gerekir.
                </p>
            }
            @if (uninitializedLotStock > 0)
            {
                <p style="font-size: 0.92rem; margin-bottom: 0;">
                    Henüz blockchain hareketi görmemiş lot stoğu: <strong>@uninitializedLotStock Adet</strong>
                    (<strong>@uninitializedLotCount lot</strong>: @string.Join(", ", uninitializedLotNumbers.Take(5))@(uninitializedLotNumbers.Count > 5 ? "..." : "")).
                </p>
            }
        </div>
    }
    else if (dbStock != bcStock)
    {
        <div style="background-color: #f8d7da; color: #721c24; padding: 15px 20px; border-left: 6px solid #f5c6cb; border-radius: 8px; margin-bottom: 30px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
            <h3 style="margin-top: 0; display: flex; align-items: center; gap: 10px; font-size: 1.3rem;">
                <strong>Veri Uyuşmazlığı Tespit Edildi!</strong>
                <span style="font-size: 1.5rem;">⚠️</span>
            </h3>
            <p style="font-size: 1.05rem; margin-bottom: 0;">Veritabanındaki stok miktarı (<strong>@dbStock Adet</strong>) ile blokzincirindeki kriptografik kayıtların toplamı (<strong>@bcStock Adet</strong>) birbiriyle uyuşmuyor. Sistemde veritabanına dışarıdan yetkisiz bir müdahale yapıldığı tespit edilmiştir.</p>
        </div>
    }
    else
    {
        <div style="background-color: #d4edda; color: #155724; padding: 15px 20px; border-left: 6px solid #c3e6cb; border-radius: 8px; margin-bottom: 30px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
            <h3 style="margin-top: 0; display: flex; align-items: center; gap: 10px; font-size: 1.3rem;">
                <strong>Veriler Doğrulandı</strong>
                <span style="font-size: 1.5rem;">✅</span>
            </h3>
            <p style="font-size: 1.05rem; margin-bottom: 0;">
                Veritabanındaki stok miktarı (<strong>@dbStock Adet</strong>) ile blokzincirindeki kriptografik kayıtların toplamı (<strong>@bcStock Adet</strong>) birbiriyle eşleşmektedir. Sistemde herhangi bir veri manipülasyonu tespit edilmemiştir.
            </p>
        </div>
    }

    if (blockchainLotStatuses.Count > 0)
    {
        <div class="bc-status-panel">
            <h3>Zincir Üzerindeki Güncel Lot Durumları</h3>
            <table class="bc-status-table">
                <thead>
                    <tr>
                        <th>Lot</th>
                        <th>Kontrat Durumu</th>
                        <th>On-chain Stok</th>
                        <th>Bekleyen Miktar</th>
                        <th>Kayıt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var status in blockchainLotStatuses.OrderBy(s => s.LotNumber))
                    {
                        <tr>
                            <td style="font-family:'Courier New', monospace; font-weight:700; color:#e94560;">@status.LotNumber</td>
                            <td><span class="bc-status-pill">@status.State</span></td>
                            <td>@status.OnChainQuantity</td>
                            <td>@status.PendingQuantity</td>
                            <td>@(status.Exists ? "Blockchain'de var" : "Blockchain'de yok")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- ─── Timeline ─── -->
    if (Model.Count > 0)
    {
    <div class="bc-timeline">
        @foreach (var record in Model)
        {
            string itemClass = "action-added", cardClass = "card-added", badgeClass = "badge-added", actionText = "";

            switch (record.Action)
            {
                case "Added":
                    if ((record.FromLocation ?? "").Contains("Başlangıç"))
                    {
                        itemClass = "action-genesis";
                        cardClass = "card-genesis";
                        badgeClass = "badge-genesis";
                        actionText = $"🔒 {record.Quantity} Adet Başlangıç Envanteri Tamamlandı";
                    }
                    else
                    {
                        actionText = $"✅ {record.Quantity} Adet Stok Eklendi";
                    }
                    break;
                case "Deducted": itemClass = "action-deducted"; cardClass = "card-deducted"; badgeClass = "badge-deducted"; actionText = $"📤 {record.Quantity} Adet Stok Düşüldü"; break;
                case "Produced": itemClass = "action-produced"; cardClass = "card-produced"; badgeClass = "badge-produced"; actionText = $"🏭 {record.Quantity} Adet Üretildi"; break;
                case "Shipped": itemClass = "action-shipped"; cardClass = "card-shipped"; badgeClass = "badge-shipped"; actionText = $"🚚 {record.Quantity} Adet Sevkiyata Çıkarıldı"; break;
                case "Received": itemClass = "action-received"; cardClass = "card-received"; badgeClass = "badge-received"; actionText = $"📦 {record.Quantity} Adet Teslim Alındı"; break;
                case "Transferred": itemClass = "action-transferred"; cardClass = "card-transferred"; badgeClass = "badge-transferred"; actionText = $"🔄 {record.Quantity} Adet Transfer Edildi"; break;
                case "Consumed":
                    if (record.FromLocation == "Stoğa Kabul Edildi")
                    {
                        itemClass = "action-added";
                        cardClass = "card-added";
                        badgeClass = "badge-added";
                        actionText = $"📦 {record.Quantity} Adet Stoğa Kabul Edildi";
                    }
                    else if (record.FromLocation == "Lab Stoğuna Kabul")
                    {
                        itemClass = "action-received";
                        cardClass = "card-received";
                        badgeClass = "badge-received";
                        actionText = $"🧪 {record.Quantity} Adet Lab Stoğuna Kabul Edildi";
                    }
                    else
                    {
                        itemClass = "action-consumed";
                        cardClass = "card-consumed";
                        badgeClass = "badge-consumed";
                        actionText = $"🔬 {record.Quantity} Adet Tüketildi";
                    }
                    break;
                case "Genesis":
                    itemClass = "action-genesis";
                    cardClass = "card-genesis";
                    badgeClass = "badge-genesis";
                    actionText = $"🔒 {record.Quantity} Adet Sistem Başlangıç Stoku";
                    break;
                default: actionText = $"{record.Quantity} Adet İşlem ({record.Action})"; break;
            }

            <div class="bc-timeline-item @itemClass">
                <div class="bc-card @cardClass">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span class="action-badge @badgeClass">@actionText</span>
                        <span class="timestamp">🕐 @record.Timestamp.ToString("dd.MM.yyyy HH:mm:ss")</span>
                    </div>
                    <div class="card-row">
                        <div>
                            <div class="label">Lot Numarası</div>
                            <div class="value" style="font-weight: 700; color: #e94560;">@record.LotNumber</div>
                        </div>
                        <div>
                            <div class="label">Cüzdan Adresi (İşlemi Yapan)</div>
                            <div class="wallet-address">@record.UserAddress</div>
                        </div>
                        @if (!string.IsNullOrEmpty(record.FromLocation) || !string.IsNullOrEmpty(record.ToLocation))
                        {
                            <div style="flex-basis: 100%; margin-top: 10px; padding-top: 10px; border-top: 1px solid #f0f0f0;">
                                <div class="label">Konum Hareketi</div>
                                <div class="value" style="margin-top: 4px;">
                                    <span style="color:#555;">@(string.IsNullOrEmpty(record.FromLocation) ? "-" : record.FromLocation)</span> 
                                    <span style="color:#ccc; margin:0 8px; font-size:1.2rem; vertical-align:-1px;">→</span> 
                                    <span style="color:#111; font-weight:700;">@(string.IsNullOrEmpty(record.ToLocation) ? "-" : record.ToLocation)</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="bc-empty">
        <div class="icon">🔍</div>
        <h4>Blockchain Kaydı Bulunamadı</h4>
        <p>Bu ürünün hiçbir alt lotu için blokzincirine kaydedilmiş bir işlem bulunmamaktadır.</p>
    </div>
}
}

<div style="margin-top: 20px;">
    <a href="javascript:history.back()" class="btn btn-secondary">← Geri Dön</a>
</div>
