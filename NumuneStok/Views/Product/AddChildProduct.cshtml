@model NumuneStok.Models.ChildProduct

<div class="container" style="max-width: 700px; margin-top: 30px;">
    <div style="background: #fff; border-radius: 12px; padding: 32px; box-shadow: 0 2px 16px rgba(0,0,0,0.08);">
        
        <div style="text-align: center; margin-bottom: 24px;">
            <div style="font-size: 3.5rem; margin-bottom: 12px;">🔗</div>
            <h2 style="margin: 0 0 8px 0; font-size: 1.4rem; font-weight: 700; color: #1e293b;">
                Tedarik Zinciri Üzerinden Stok Girişi
            </h2>
            <p style="color: #64748b; font-size: 0.95rem; max-width: 500px; margin: 0 auto; line-height: 1.6;">
                Veri bütünlüğünü ve izlenebilirliği sağlamak amacıyla, stok girişleri artık 
                <strong>Tedarik Zinciri Simülasyonu</strong> üzerinden yapılmaktadır. 
                Her ürün girişi, üretim → sevkiyat → teslim alma sürecinden geçerek blockchain'e kaydedilir.
            </p>
        </div>

        <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 16px; margin-bottom: 24px;">
            <div style="display: flex; align-items: flex-start; gap: 12px;">
                <span style="font-size: 1.3rem;">ℹ️</span>
                <div>
                    <div style="font-weight: 700; color: #1e40af; font-size: 0.9rem; margin-bottom: 4px;">Neden Simülasyon Üzerinden?</div>
                    <p style="margin: 0; font-size: 0.85rem; color: #1e3a5f; line-height: 1.5;">
                        Doğrudan stok ekleme, blockchain'de tedarik zinciri izi bırakmaz. 
                        Bu da izlenebilirlik ve denetim açısından eksiklik yaratır. 
                        Simülasyon ile her ürünün üreticiden depoya kadar olan tüm yolculuğu değiştirilemez şekilde kayıt altına alınır.
                    </p>
                </div>
            </div>
        </div>

        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
            <a href="@Url.Action("SupplyChainSimulation", "Product")" 
               style="display: inline-flex; align-items: center; gap: 8px; background: #2563eb; color: #fff; padding: 12px 28px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.95rem; transition: background 0.2s;"
               onmouseover="this.style.background='#1d4ed8'" onmouseout="this.style.background='#2563eb'">
                🏭 Tedarik Zinciri Simülasyonuna Git
            </a>
            <a href="@Url.Action("Index", "Product")" 
               style="display: inline-flex; align-items: center; gap: 8px; background: #e2e8f0; color: #475569; padding: 12px 28px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.95rem; transition: background 0.2s;"
               onmouseover="this.style.background='#cbd5e1'" onmouseout="this.style.background='#e2e8f0'">
                ← Geri Dön
            </a>
        </div>
    </div>
</div>