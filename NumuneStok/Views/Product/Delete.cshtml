@model NumuneStok.Models.Product

<h2>Ürün Sil</h2>

<h3>Bu ürünü silmek istediğinize emin misiniz?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Id</dd>
        <dt class="col-sm-2">Ürün Adı</dt>
        <dd class="col-sm-10">@Model.ProductName</dd>
        <dt class="col-sm-2">Referans Numarası</dt>
        <dd class="col-sm-10">@Model.ReferenceNumber</dd>
        <dt class="col-sm-2">Barkod</dt>
        <dd class="col-sm-10">@Model.Barcode</dd>
        <dt class="col-sm-2">Konum</dt>
        <dd class="col-sm-10">@Model.Location</dd>
        <dt class="col-sm-2">Ader</dt>
        <dd class="col-sm-10">@Model.Quantity</dd>
        <dt class="col-sm-2">Kategori</dt>
        <dd class="col-sm-10">@Model.Category.CategoryName</dd>
    </dl>
</div>
</br>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sil</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>