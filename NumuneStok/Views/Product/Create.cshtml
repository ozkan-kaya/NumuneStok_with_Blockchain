@model NumuneStok.Models.Product

<div class="d-flex justify-content-between align-items-center">
    <h2>Yeni Ürün Ekle</h2>
    <button type="button" class="btn btn-success" data-toggle="modal" data-target="#barcodeModal">
        Barkod ile Ekle
    </button>
</div>

<form asp-action="Create">
    <div class="form-group">
        Ürün Adı
        <input asp-for="ProductName" class="form-control" />
        <span asp-validation-for="ProductName" class="text-danger"></span>
    </div>

    <div class="form-group">
        Referans Numarası
        <input asp-for="ReferenceNumber" id="ReferenceNumber" class="form-control" />
        <span asp-validation-for="ReferenceNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        Aylık Sipariş Adeti
        <input asp-for="Order" class="form-control" />
        <span asp-validation-for="Order" class="text-danger"></span>
    </div>

    <div class="form-group">
        Kritik Eşik
        <input asp-for="Critical" class="form-control" />
        <span asp-validation-for="Critical" class="text-danger"></span>
    </div>

    <div class="form-group">
        Test Değeri
        <input asp-for="MultiplicationValue" class="form-control" />
        <span asp-validation-for="MultiplicationValue" class="text-danger"></span>
    </div>

    <div class="form-group">
        Kategori
        <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories"></select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Ekle" class="btn btn-primary" />
    </div>
</form>

<!-- Barkod Pop-up Modal -->
<div class="modal fade" id="barcodeModal" tabindex="-1" role="dialog" aria-labelledby="barcodeModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="barcodeModalLabel">Barkod Okut</h5>
            </div>
            <div class="modal-body">
                <input type="text" id="barcodeInput" class="form-control text-center" placeholder="Barkodu okutunuz" autofocus />
            </div>
            <div class="modal-footer">
                <button type="button" id="closeModalButton" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('barcodeInput').addEventListener('keyup', function (event) {
        if (event.key === 'Enter') {
            event.preventDefault();

            const barcode = event.target.value.trim();

            if (barcode.length >= 48) {
                const referenceCode = barcode.substring(37, 48); // Referans kodu

                // Referans Numarası alanına değeri aktar
                document.getElementById('ReferenceNumber').value = referenceCode;


                // Kapatma butonunu programatik olarak tıklat
                document.getElementById('closeModalButton').click();

                // Barkod alanını temizle
                event.target.value = "";
            } else {
                // Barkod yetersiz uzunlukta
                alert("Barkod eksik veya hatalı. Lütfen tekrar deneyin.");
                event.target.value = ""; // Barkod alanını temizle
            }
        }
    });
</script>

<!-- Bootstrap ve jQuery Bağımlılıkları -->
<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.bundle.min.js"></script>
