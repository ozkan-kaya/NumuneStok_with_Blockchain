@model NumuneStok.Models.Product

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- CSS Kütüphaneleri -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.dataTables.css">

    <!-- JavaScript Kütüphaneleri -->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/dataTables.buttons.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.dataTables.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.print.min.js"></script>
    <style>
        /* CSS yanıp sönme işlemi */
        .blinking-alert {
            font-size: 16px;
            font-weight: bold;
            color: red;
        }
    </style>
</head>


<div class="d-flex justify-content-between align-items-center">
    <h2>Ürün Stoklarını Yönet: @Model.ProductName</h2>
    <a asp-action="AddChildProduct" asp-route-productId="@Model.Id" class="btn btn-success">Bu Ürüne Stok Ekle</a>
</div>


<table id="example" class="display nowrap" style="width:100%">
    <thead>
        <tr>
            <th scope="col">Lot Numarası</th>
            @*<th scope="col">Üretim Tarihi</th>*@
            <th scope="col">Son Tüketim Tarihi</th>
            <th scope="col">Miktar</th>
            <th scope="col">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ChildProducts)
        {
            var daysRemaining = (item.ExpirationDate - DateTime.Now).Days;

            <tr>
                <td>@item.LotNumber</td>
                @*<td>@item.ProductionDate.ToShortDateString()</td>*@
                <td>@item.ExpirationDate.ToString("dd/MM/yyyy")</td>
                <td>@item.Quantity</td>
                <td>
                    @if (daysRemaining < 30) // 30 günden az kalanlar için uyarı
                    {
                        <span class="blinking-alert">⚠️ SKT Yaklaşıyor!</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<!-- DataTables Başlatma -->
<script>new DataTable('#example', {
        layout: {
            topStart: {
                buttons: ['copy', 'csv', 'excel', 'pdf', 'print']
            }
        }
    });</script>

<script>// JavaScript ile yanıp sönme
    function startBlinking() {
        let alerts = document.querySelectorAll('.blinking-alert');
        alerts.forEach(alert => {
            setInterval(() => {
                if (alert.style.visibility === 'hidden') {
                    alert.style.visibility = 'visible';
                } else {
                    alert.style.visibility = 'hidden';
                }
            }, 500); // 0.5 saniye aralıklarla yanıp sönme
        });
    }

    // Sayfa yüklendikten sonra yanıp sönme başlasın
    window.onload = startBlinking;</script>