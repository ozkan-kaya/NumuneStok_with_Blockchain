@model NumuneStok.Models.User
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
    <meta name="description" content="Inncrea - Admin Template">
    <meta name="keywords" content="admin, estimates, bootstrap, business, corporate, creative, management, minimal, modern, html5, responsive">
    <meta name="author" content="Inncrea - Bootstrap Admin Template">
    <meta name="robots" content="noindex, nofollow">
    <title>Numune Stok Takip</title>

    <link rel="shortcut icon" type="image/x-icon" href="~/inventory/assets/img/favicon-32x32.png">
    <link rel="stylesheet" href="~/inventory/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/inventory/assets/css/animate.css">
    <link rel="stylesheet" href="~/inventory/assets/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/inventory/assets/plugins/fontawesome/css/fontawesome.min.css">
    <link rel="stylesheet" href="~/inventory/assets/plugins/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="~/inventory/assets/css/style.css">
</head>
<body>
    <div id="global-loader">
        <div class="whirly-loader"></div>
    </div>

    <div class="main-wrapper d-flex align-items-center justify-content-center vh-100">
        <!-- Login Kartı Başlangıcı -->
        <div class="card" style="width: 400px; box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.2);">
            <div class="card-body">
                <div class="login-content text-center">
                    <div class="login-logo mb-3">
                        <img src="~/inventory/assets/img/inncrea.png" alt="img" class="img-fluid">
                    </div>
                    <h3>Numune Stok Takip</h3>
                    <p>Hesabınıza giriş yapınız</p>
                </div>
                <!-- Form -->
                <form asp-action="Login" method="post">
                    <div class="form-login mt-4">
                        <label>Kullanıcı Adı</label>
                        <div class="pass-group mb-3">
                            <input type="text" name="username" class="form-control" placeholder="Kullanıcı adınızı giriniz" required />
                        </div>
                    </div>
                    <div class="form-login">
                        <label>Şifre</label>
                        <div class="pass-group mb-3">
                            <input type="password" name="password" class="form-control pass-input" placeholder="Şifrenizi giriniz" required />
                            <span class="fas toggle-password fa-eye-slash"></span>
                        </div>
                    </div>
                    @*<div class="form-login">
                        <div class="alreadyuser text-right">
                            <h4><a href="forgetpassword.html" class="hover-a">Şifremi Unuttum?</a></h4>
                        </div>
                    </div>*@
                    <div class="form-login text-center mt-4">
                        <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
                    </div>
                </form>
                @*<div class="signinform text-center mt-3">
                    <h4>Hesabınız yok mu? <a href="/Account/Register" class="hover-a">Kayıt Ol</a></h4>
                </div>*@
                <p class="text-danger text-center mt-2">@ViewBag.Error</p>
            </div>
        </div>
        <!-- Login Kartı Sonu -->
    </div>

    <script src="~/inventory/assets/js/jquery-3.6.0.min.js"></script>
    <script src="~/inventory/assets/js/feather.min.js"></script>
    <script src="~/inventory/assets/js/jquery.slimscroll.min.js"></script>
    <script src="~/inventory/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/inventory/assets/js/script.js"></script>
</body>
</html>
